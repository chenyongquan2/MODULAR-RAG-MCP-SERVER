    "output_format_instruction": "",
    "examples": [
        {
            "context": "output: \"\u57c3\u83f2\u5c14\u94c1\u5854\u4f7f\u7528\u94c1\u5efa\u9020\uff0c\u6700\u521d\u662f\u4f5c\u4e3a1889\u5e74\u5728\u5df4\u9ece\u4e3e\u529e\u7684\u4e16\u754c\u535a\u89c8\u4f1a\u7684\u4e34\u65f6\u5c55\u54c1\u3002\u5c3d\u7ba1\u6700\u521d\u662f\u4e34\u65f6\u7528\u9014\uff0c\u57c3\u83f2\u5c14\u94c1\u5854\u5f88\u5feb\u6210\u4e3a\u5df4\u9ece\u667a\u6167\u7684\u8c61\u5f81\u548c\u8be5\u57ce\u5e02\u7684\u6807\u5fd7\u6027\u5efa\u7b51\uff0c\u6bcf\u5e74\u5438\u5f15\u6570\u767e\u4e07\u6e38\u5ba2\u3002\u5854\u7684\u8bbe\u8ba1\u7531\u53e4\u65af\u5854\u592b\u00b7\u57c3\u83f2\u5c14\u521b\u4f5c\uff0c\u6700\u521d\u906d\u5230\u4e00\u4e9b\u6cd5\u56fd\u827a\u672f\u5bb6\u548c\u77e5\u8bc6\u5206\u5b50\u7684\u6279\u8bc4\uff0c\u4f46\u6b64\u540e\u88ab\u8d5e\u8a89\u4e3a\u7ed3\u6784\u5de5\u7a0b\u548c\u5efa\u7b51\u8bbe\u8ba1\u65b9\u9762\u7684\u6770\u4f5c\u3002\"",
            "question": "\"\u8fd9\u5ea7\u5854\u662f\u8c01\u8bbe\u8ba1\u7684\uff1f\"",
            "feedback": "\u8fd9\u4e2a\u95ee\u9898\u8be2\u95ee\u5173\u4e8e\u201c\u5854\u201d\u7684\u8bbe\u8ba1\u521b\u4f5c\u8005\uff0c\u4f46\u6ca1\u6709\u5177\u4f53\u8bf4\u660e\u6307\u7684\u662f\u54ea\u5ea7\u5854\u3002\u4e16\u754c\u4e0a\u6709\u5f88\u591a\u5854\uff0c\u5982\u679c\u4e0d\u6307\u660e\u5177\u4f53\u7684\u5854\uff0c\u95ee\u9898\u5c31\u542b\u7cca\u4e0d\u6e05\u4e14\u65e0\u6cd5\u56de\u7b54\u3002\u4e3a\u4e86\u6539\u8fdb\u8fd9\u4e2a\u95ee\u9898\uff0c\u5e94\u8be5\u63d0\u4f9b\u8be5\u5854\u7684\u540d\u79f0\u6216\u6e05\u6670\u7684\u63cf\u8ff0\u3002"
        },
        {
            "context": "\u300a\u63a2\u7d22\u96f6\u6837\u672c\u5b66\u4e60\u5728\u795e\u7ecf\u7f51\u7edc\u4e2d\u7684\u5e94\u7528\u300b\u7531Smith\u548cLee\u4e8e2021\u5e74\u53d1\u8868\uff0c\u805a\u7126\u4e8e\u96f6\u6837\u672c\u5b66\u4e60\u6280\u672f\u5728\u4eba\u5de5\u667a\u80fd\u4e2d\u7684\u5e94\u7528\u3002",
            "question": "\u672c\u7814\u7a76\u4f7f\u7528\u4e86\u54ea\u4e9b\u6570\u636e\u96c6\u8fdb\u884c\u96f6\u6837\u672c\u8bc4\u4f30\uff1f",
            "feedback": "output: \"\u8fd9\u4e2a\u95ee\u9898\u8be2\u95ee\u7684\u662f\u2018\u672c\u7814\u7a76\u4e2d\u2019\u7528\u4e8e\u96f6\u6837\u672c\u8bc4\u4f30\u7684\u6570\u636e\u96c6\uff0c\u5374\u6ca1\u6709\u8bf4\u660e\u6216\u63d0\u4f9b\u5173\u4e8e\u8be5\u7814\u7a76\u7684\u4efb\u4f55\u7ec6\u8282\u3002\u8fd9\u4f7f\u5f97\u95ee\u9898\u5bf9\u90a3\u4e9b\u6ca1\u6709\u83b7\u53d6\u6216\u4e86\u89e3\u8be5\u5177\u4f53\u7814\u7a76\u7684\u4eba\u4e0d\u591f\u6e05\u6670\u3002\u4e3a\u4e86\u63d0\u9ad8\u6e05\u6670\u5ea6\u548c\u53ef\u7b54\u6027\uff0c\u95ee\u9898\u5e94\u6307\u660e\u6240\u6d89\u53ca\u7684\u7814\u7a76\uff0c\u6216\u63d0\u4f9b\u8db3\u591f\u7684\u80cc\u666f\u4fe1\u606f\uff0c\u4f7f\u95ee\u9898\u80fd\u591f\u88ab\u72ec\u7acb\u7406\u89e3\u548c\u56de\u7b54\u3002\""
        }
