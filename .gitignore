# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual Environment
.venv/
venv/
ENV/

# Environment Variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Data & Cache (keep directory structure, ignore contents)
data/documents/**/*
data/images/**/*
data/db/**/*
cache/embeddings/**/*
cache/captions/**/*
cache/processing/**/*
logs/*.jsonl
logs/*.log
# Feature-001: 评估报告归档目录(每次评估产出 <run_id>.json + index.jsonl)
logs/evaluation_reports/
# Feature-001: 基线标记单文件(US3 阶段使用,每次标记 atomic 写)
logs/baselines.json

# Keep .gitkeep files
!**/.gitkeep

# Pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# mypy
.mypy_cache/

# AI Agent - 本地用户配置
.claude/settings.local.json

# 临时文件
*.bak
*.tmp
# Development scripts (not to be committed)
scripts/dev/*
# 探针脚本破例入库 —— settings.yaml 注释与 docs/learning 把它们当可执行凭据引用
# (写成 scripts/dev/* 而非 scripts/dev/ 是必须的:父目录被排除后否定规则会失效)
!scripts/dev/probe_*.py

# 二进制测试文件（CHM 等）
*.chm

# Secrets
secrets.yaml

# Claude Code
.claude/

# Feature-001: RAGAS adapt cache (machine-specific, regenerable)
logs/ragas_adapt_cache/
# Feature-001: smoke test artifacts
tests/fixtures/candidates/*_smoke*.json

# 探针原始 prompt 明细(与 ragas_adapt_cache 同源,机器生成);只保留顶层 summary 作结论凭据
logs/ragas_adapt_probe/*/

# 探针运行日志(过程输出,非结论凭据;顶层 logs/*.log 规则盖不到子目录)
logs/**/*.log
